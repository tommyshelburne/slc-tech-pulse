# Firebase web-app config — copy to .env.local and fill in from
# Firebase console → Project settings → Your apps → SDK setup and configuration.
# The seed script (scripts/seed.ts) uses Admin SDK with .secrets/firebase-admin.json
# and does not read these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=slc-tech-pulse.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=slc-tech-pulse
VITE_FIREBASE_STORAGE_BUCKET=slc-tech-pulse.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
